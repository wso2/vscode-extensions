{
	"name": "@wso2/wso2-cloud-client",
	"version": "0.1.0",
	"description": "Sign-in and a typed client for the WSO2 Cloud Integration Platform API, for VS Code extensions",
	"files": [
		"lib",
		"docs",
		"README.md"
	],
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./testing": {
			"types": "./lib/testing/index.d.ts",
			"default": "./lib/testing/index.js"
		},
		"./openapi": {
			"types": "./lib/api/generated/ipaas.d.ts",
			"default": "./lib/api/generated/ipaas.js"
		}
	},
	"typesVersions": {
		"*": {
			"testing": [
				"lib/testing/index.d.ts"
			],
			"openapi": [
				"lib/api/generated/ipaas.d.ts"
			]
		}
	},
	"scripts": {
		"generate": "npx --yes openapi-typescript@7.13.0 spec/ipaas-openapi.yaml -o src/api/generated/ipaas.ts --alphabetize --root-types && npx --yes @biomejs/biome@1.9.4 format --write src/api/generated/ipaas.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"build": "tsc --pretty",
		"watch": "tsc --pretty --watch",
		"test": "mocha",
		"deploy": "npm publish"
	},
	"author": "WSO2",
	"license": "Apache-2.0",
	"peerDependencies": {
		"@types/vscode": "*"
	},
	"peerDependenciesMeta": {
		"@types/vscode": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/mocha": "10.0.1",
		"@types/node": "22.15.21",
		"@types/vscode": "1.100.0",
		"mocha": "11.5.0",
		"ts-node": "10.9.2",
		"typescript": "5.8.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wso2/vscode-extensions.git"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com/"
	}
}
